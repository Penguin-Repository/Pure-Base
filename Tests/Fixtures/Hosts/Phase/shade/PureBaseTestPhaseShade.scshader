Shader "PureBase/Tests/ShaderCore/Phase/Shade"
{
    // The Apache notice follows because Shader-Core importer discovery requires Shader first.
    /*
     * Copyright 2026 Penguin
     *
     * Licensed under the Apache License, Version 2.0 (the "License");
     * you may not use this file except in compliance with the License.
     * You may obtain a copy of the License at
     *
     *     http://www.apache.org/licenses/LICENSE-2.0
     *
     * Unless required by applicable law or agreed to in writing, software
     * distributed under the License is distributed on an "AS IS" BASIS,
     * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
     * See the License for the specific language governing permissions and
     * limitations under the License.
     */

    // Defines the persistent shade-phase Shader-Core test host.
    Properties
    {
        _PhaseHostColor ("Phase Host Color", Color) = (0.125,0.125,0.125,1)
        [Range(0,1)] _PhaseHostCutoff ("Phase Host Cutoff", Float) = 0.5
        _PhaseHostRuntimeGate ("Phase Host Runtime Gate", Float) = 0
        [NoScaleOffset] _PhaseHostMask ("__PhaseHostMask", 2D) = "white" {}
        [NoScaleOffset] _PhaseHostGradients ("__PhaseHostGradients", 2DArray) = "white" {}
    }

    HLSLINCLUDE
    __SC_SHADERKEYWORDS__
    ENDHLSL

    SubShader
    {
        Tags { "RenderType" = "Opaque" "Queue" = "Geometry" }

        Pass
        {
            Name "ForwardBase"
            Tags { "LightMode" = "ForwardBase" }
            Cull Back
            ZWrite On
            ZTest LEqual

            HLSLPROGRAM
            #pragma target 5.0
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/birp_forward.hlsl"
            #include "Packages/jp.penguin.purebase/Tests/Fixtures/Hosts/Common/phase_host_common.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "ForwardAdd"
            Tags { "LightMode" = "ForwardAdd" }
            Cull Back
            ZWrite Off
            ZTest LEqual
            Blend One One
            ColorMask RGB

            HLSLPROGRAM
            #pragma target 5.0
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/birp_forwardadd.hlsl"
            #include "Packages/jp.penguin.purebase/Tests/Fixtures/Hosts/Common/phase_host_common.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "ShadowCaster"
            Tags { "LightMode" = "ShadowCaster" }
            Cull Back
            ZWrite On
            ZTest LEqual
            ColorMask 0

            HLSLPROGRAM
            #pragma target 5.0
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/birp_shadowcaster.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "Meta"
            Tags { "LightMode" = "Meta" }
            Cull Off

            HLSLPROGRAM
            #pragma target 2.0
            #pragma vertex PhaseHostMetaVertex
            #pragma fragment PhaseHostMetaFragment
            #include "UnityCG.cginc"
            #include "UnityMetaPass.cginc"
            __SC_BIRP_properties__
            #include "Packages/jp.penguin.purebase/Tests/Fixtures/Hosts/Common/phase_host_meta.hlsl"
            ENDHLSL
        }
    }
}